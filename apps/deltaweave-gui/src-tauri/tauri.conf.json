{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeltaWeave",
  "version": "0.3.0",
  "identifier": "byte.happyaspic.deltaweave",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeltaWeave",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/deltaweave-daemon"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
